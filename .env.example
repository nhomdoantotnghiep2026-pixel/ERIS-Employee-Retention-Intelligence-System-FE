# Public frontend configuration only. Never put credentials in VITE_* variables.
VITE_API_BASE_URL=/api
# Local API service; change this if your backend uses a different port.
VITE_BACKEND_URL=http://127.0.0.1:3000
# Must match CORS_ORIGIN configured in the backend.
VITE_BACKEND_ALLOWED_ORIGIN=http://127.0.0.1:5173
# Optional separate admin/users backend (System- repo, backend-maintenance branch).
# Leave VITE_ADMIN_API_BASE_URL empty when one backend provides all APIs.
VITE_ADMIN_API_BASE_URL=/admin-api
VITE_ADMIN_BACKEND_URL=http://127.0.0.1:3001
